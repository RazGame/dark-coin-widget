<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root_short" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget_container" android:padding="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_coin" android:importantForAccessibility="no" />
            <TextView android:id="@+id/widget_balance_short" android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="16sp" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:fontFamily="@font/unisans_bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_coins_label_short" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/coins_unit" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="2dp" />
    </LinearLayout>
    <FrameLayout android:id="@+id/widget_btn_scan_short" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_widget_circle_btn" android:clickable="true" android:focusable="true" android:contentDescription="@string/scan_qr_short">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_scan_qr" android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
