<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: User Profile & Sync Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_user"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_user_name_4x2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/unisans_bold"
                android:singleLine="true"
                android:text="DARKSIDE"
                android:textColor="@color/ds_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="DARKSIDE CLUB"
                android:textColor="@color/ds_text_secondary"
                android:textSize="8sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Top Right: Refresh Button -->
        <ImageView
            android:id="@+id/widget_btn_refresh_4x2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_pill_badge"
            android:contentDescription="@string/refresh_btn"
            android:padding="6dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- Center Cards: Balance Card & Scan Action Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Balance Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_inner_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/balance_label"
                android:textColor="@color/ds_text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_coin"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:id="@+id/widget_balance_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unisans_heavy"
                    android:singleLine="true"
                    android:text="1 781"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/unisans_bold"
                    android:singleLine="true"
                    android:text="@string/coins_unit"
                    android:textColor="@color/ds_primary"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status_sub_4x2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Готов к сканированию"
                android:textColor="@color/ds_text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Right: Scan Action Card -->
        <LinearLayout
            android:id="@+id/widget_btn_scan_4x2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_widget_circle_icon_dark"
                android:contentDescription="@string/scan_qr"
                android:padding="5dp"
                android:src="@drawable/ic_scan_qr_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="none"
                android:fontFamily="@font/unisans_bold"
                android:singleLine="true"
                android:text="@string/scan_qr"
                android:textColor="@color/ds_on_primary_container"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:singleLine="true"
                android:text="@string/scan_qr_subtitle"
                android:textColor="@color/ds_on_primary_container"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Footer: Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_last_sync_4x2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Нажми для быстрого сканирования"
            android:textColor="@color/ds_text_tertiary"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unisans_bold"
            android:singleLine="true"
            android:text="DARKSIDE WORLD"
            android:textColor="@color/ds_primary"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
