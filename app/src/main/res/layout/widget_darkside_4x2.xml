<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header: User Profile & Sync Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_user"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_user_name_4x2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/unisans_bold"
                android:singleLine="true"
                android:text="DARKSIDE"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_club_label_4x2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="DARKSIDE WORLD"
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Top Right: Refresh Button & Indeterminate Progress (Min 48x48dp touch target) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/widget_btn_refresh_4x2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_badge"
                android:contentDescription="@string/refresh_btn"
                android:padding="13dp"
                android:src="@drawable/ic_refresh" />

            <ProgressBar
                android:id="@+id/widget_progress_refresh_4x2"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Center Cards: Balance Card & Scan Action Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Balance Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_inner_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/balance_label"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_coin"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:id="@+id/widget_balance_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unisans_heavy"
                    android:singleLine="true"
                    android:text="1 781"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/widget_coins_label_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/unisans_bold"
                    android:singleLine="true"
                    android:text="@string/coins_unit"
                    android:textColor="@color/widget_accent"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: Scan Action Card (Min 48dp touch target) -->
        <LinearLayout
            android:id="@+id/widget_btn_scan_4x2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/scan_qr"
                android:src="@drawable/ic_scan_qr" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="none"
                android:fontFamily="@font/unisans_bold"
                android:singleLine="true"
                android:text="@string/scan_qr"
                android:textColor="@color/widget_action_card_text"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:singleLine="true"
                android:text="@string/scan_qr_subtitle"
                android:textColor="@color/widget_action_card_text"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Footer: Info -->
    <TextView
        android:id="@+id/widget_last_sync_4x2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Нажми для быстрого сканирования"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="9sp" />

</LinearLayout>
