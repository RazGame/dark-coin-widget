<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header: Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="36dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_darkside_logo" />
            </LinearLayout>

            <!-- State 1: Not Logged In Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_not_logged_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unisans_bold"
                        android:text="@string/not_logged_in"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tap_to_login"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/unisans_bold"
                        android:text="@string/login_btn"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        app:cornerRadius="100dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- State 2: Logged In Dashboard Card (Material 3 Expressive Tonal Surface) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_logged_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- User Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_user"
                            android:contentDescription="@string/app_name" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_user_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/unisans_bold"
                                android:text="Пользователь"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tv_user_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Аккаунт подключен"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Refresh Action (Min 48x48dp touch target) -->
                        <ImageView
                            android:id="@+id/btn_refresh"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_pill_badge"
                            android:contentDescription="@string/refresh_btn"
                            android:padding="13dp"
                            android:src="@drawable/ic_refresh" />
                    </LinearLayout>

                    <!-- Expressive Hero Balance Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_widget_inner_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/balance_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_coin"
                                android:contentDescription="@string/app_name" />

                            <TextView
                                android:id="@+id/tv_balance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/unisans_heavy"
                                android:text="0"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="32sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/unisans_bold"
                                android:text="@string/coins_unit"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_last_sync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Синхронизировано"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Hero Action: Scan QR (Expressive Pill Button) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_scan"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/unisans_bold"
                        android:text="@string/test_scan_btn"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        app:cornerRadius="100dp"
                        app:icon="@drawable/ic_scan_qr"
                        app:iconTint="?attr/colorOnPrimaryContainer" />

                    <!-- Secondary Action: Pin Widget (Outlined / Tonal) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pin_widget"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/unisans_bold"
                        android:text="@string/pin_widget_btn"
                        android:textColor="?attr/colorOnSurface"
                        app:backgroundTint="?attr/colorSurfaceContainerHigh"
                        app:cornerRadius="100dp" />

                    <!-- Tertiary Action: Logout -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_logout"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/logout_btn"
                        android:textColor="?attr/colorError" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Guide Card (Tonal separation) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unisans_bold"
                        android:text="О виджете"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Добавьте виджет Darkside на домашний экран вашего Android устройства. Виджет адаптивный (поддерживает размеры 2x2, 4x1 и 4x2), следует динамической системной теме Material You и запускает моментальное сканирование пачек!"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
