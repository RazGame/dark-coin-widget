<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root_tall" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget_container" android:padding="12dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:id="@+id/widget_user_name_tall" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Пользователь" android:textSize="13sp" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:fontFamily="@font/unisans_bold" />
        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp">
            <ImageView android:id="@+id/widget_btn_refresh_tall" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:background="@drawable/bg_pill_badge" android:src="@drawable/ic_refresh" android:contentDescription="@string/refresh_btn" />
            <ProgressBar android:id="@+id/widget_progress_refresh_tall" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:indeterminate="true" android:visibility="gone" style="?android:attr/progressBarStyleSmall" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_widget_inner_card" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/widget_balance_heading_tall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balance_label" android:textSize="12sp" android:textColor="@color/widget_text_secondary" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" />
            <LinearLayout android:id="@+id/widget_balance_row_tall" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_coin" android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_balance_tall" android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="28sp" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:fontFamily="@font/unisans_heavy" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
            <TextView android:id="@+id/widget_coins_label_tall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/coins_unit" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:paddingStart="32dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_btn_scan_tall" android:layout_width="wrap_content" android:layout_height="56dp" android:minWidth="64dp" android:layout_marginTop="16dp" android:background="@drawable/bg_widget_pill_button" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/scan_qr_short">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_scan_qr" android:importantForAccessibility="no" />
            <TextView android:id="@+id/widget_scan_label_tall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/scan_qr_short" android:textSize="16sp" android:textColor="@color/widget_action_card_text" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:paddingStart="8dp" android:fontFamily="@font/unisans_bold" />
        </LinearLayout>
        <TextView android:id="@+id/widget_last_sync_tall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Синхронизация" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
