<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_2x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top: Balance Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_coin" />

        <TextView
            android:id="@+id/widget_balance_2x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unisans_heavy"
            android:singleLine="true"
            android:text="1 781"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Subtitle: Currency Unit -->
    <TextView
        android:id="@+id/widget_coins_label_2x2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/unisans_bold"
        android:singleLine="true"
        android:text="@string/coins_unit"
        android:textColor="@color/widget_accent"
        android:textSize="9sp" />

    <!-- Center Action: Scan Button (Min 44dp height) -->
    <LinearLayout
        android:id="@+id/widget_btn_scan_2x2"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_widget_action_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/scan_qr"
            android:src="@drawable/ic_scan_qr" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/unisans_bold"
            android:singleLine="true"
            android:text="@string/scan_qr_short"
            android:textColor="@color/widget_action_card_text"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
