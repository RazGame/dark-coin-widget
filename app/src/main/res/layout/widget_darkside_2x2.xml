<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_2x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top mini header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_coins_label_2x2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/unisans_bold"
            android:singleLine="true"
            android:text="DARK COIN"
            android:textColor="@color/widget_accent"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_balance_2x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unisans_heavy"
            android:singleLine="true"
            android:text="1 781"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Big Round Button (Min 52x52dp touch target) -->
    <ImageView
        android:id="@+id/widget_btn_scan_2x2"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_widget_circle_btn"
        android:clickable="true"
        android:contentDescription="@string/scan_qr"
        android:focusable="true"
        android:padding="14dp"
        android:src="@drawable/ic_scan_qr" />

    <!-- Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/unisans_bold"
        android:singleLine="true"
        android:text="@string/scan_qr_short"
        android:textColor="@color/widget_text_primary"
        android:textSize="10sp" />

</LinearLayout>
