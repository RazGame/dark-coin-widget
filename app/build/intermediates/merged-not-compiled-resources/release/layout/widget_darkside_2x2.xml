<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_2x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top mini header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DS"
            android:textColor="@color/ds_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_balance_2x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 781 ©"
            android:textColor="@color/ds_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Big Round Button -->
    <ImageView
        android:id="@+id/widget_btn_scan_2x2"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_widget_circle_btn"
        android:clickable="true"
        android:contentDescription="@string/scan_qr"
        android:focusable="true"
        android:padding="14dp"
        android:src="@drawable/ic_scan_qr" />

    <!-- Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scan_qr_short"
        android:textColor="@color/ds_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
